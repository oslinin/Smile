# Deployer private key (no 0x prefix)
PRIVATE_KEY=

# RPC endpoints
RPC_SEPOLIA=https://sepolia.infura.io/v3/YOUR_KEY
RPC_MAINNET=https://mainnet.infura.io/v3/YOUR_KEY

# Chainlink CRE forwarder address (set after CRE workflow is registered)
CRE_FORWARDER=

# WETH address (defaults to mainnet if unset)
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2

# Optional — Pyth pull-oracle for quoting (README §6, docs/solutions.md R5).
# Leave both unset to quote off Chainlink Data Feeds (the default). Set both
# to deploy PythSpotAdapter instead, giving buy()/close() a ~400ms-fresh
# price instead of Chainlink's last published round. Settlement (§5) always
# uses Chainlink regardless of this setting.
# PYTH: the Pyth contract address for your target chain — look up the
# current address at https://docs.pyth.network/price-feeds/core/contract-addresses/evm
PYTH=
# PYTH_PRICE_ID: the feed id to quote. ETH/USD is the same id on every chain:
PYTH_PRICE_ID=0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace

# WalletConnect — get a free project ID at cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Uniswap Trading API — get a key at developer.uniswap.org
# Used to fetch live ETH/USDC spot price (optional — falls back to $3420)
NEXT_PUBLIC_UNISWAP_API_KEY=

# Filled in by `forge script script/Deploy.s.sol --broadcast`
NEXT_PUBLIC_PRICING_ENGINE=
NEXT_PUBLIC_AQUA_VAULT=
NEXT_PUBLIC_SETTLEMENT=

# ── AI Copilot (chat panel in the dApp) ──────────────────────────────────────
# Put these in frontend/.env.local — local.sh preserves them across restarts.
# Provider: anthropic | openai | google | openrouter. Only the matching key is required.
# openrouter is OpenAI-API-compatible and routes to hundreds of models with one key.
# Keys stay server-side (no NEXT_PUBLIC_ prefix — never sent to the browser).
COPILOT_PROVIDER=anthropic
# Optional model override (defaults: claude-opus-4-8 / gpt-5-mini / gemini-2.5-pro / openrouter/auto)
COPILOT_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# RPC used by copilot on-chain reads when the UI is on Sepolia (optional)
COPILOT_RPC_SEPOLIA=
# Show the copilot widget (unset on the static GitHub Pages build, which has no API server)
NEXT_PUBLIC_COPILOT=1

# ── The Graph subgraph (subgraph/) ────────────────────────────────────────────
# When set, the LP Dashboard and the copilot's position reads query the
# subgraph instead of scanning the chain (the scan is capped at 50
# authorizations — docs/limitations.md L12a). Leave unset for local Anvil
# dev without an indexer; the RPC path is the fallback either way.
#   local graph-node (x86-64 hosts): http://localhost:8100/subgraphs/name/smile/local
#   Graph Studio:  https://api.studio.thegraph.com/query/<id>/smile-sepolia/version/latest
# Graph Studio query URL, e.g. https://api.studio.thegraph.com/query/44448/smile-sepolia/v0.0.1
# (see subgraph/README.md). Unset = the app and copilot fall back to RPC scans.
NEXT_PUBLIC_SUBGRAPH_URL=
