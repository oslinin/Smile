# Smile on Circle's Arc MAINNET — docs/arc-mainnet-checklist.md
#
# Arc mainnet goes public on 2026-09-16. Nothing below is filled in on purpose:
# the chain id, RPC and explorer are not in Circle's docs yet (docs.arc.io
# documents only testnet 5042002) and MUST be copied from the official
# "Connect to Arc" page on launch day — never from a third-party site.
#
# Two consumers:
#   forge script script/Deploy.s.sol   reads the ARC_MAINNET_* variables
#   frontend (copy to frontend/.env.local) reads the NEXT_PUBLIC_* variables

# ── Deploy script (forge) ────────────────────────────────────────────────────
# Chain id from https://docs.arc.io/arc/references/connect-to-arc (mainnet row).
ARC_MAINNET_CHAIN_ID=
# Deployer with real USDC on Arc (gas is USDC; testnet full-stack deploy cost ~0.46 USDC).
PRIVATE_KEY=
# Circle's USDC on Arc — on testnet it is the native asset's 6-dec ERC-20 view at
# 0x3600…0000; confirm the mainnet address on Circle's "USDC contract addresses"
# page. Leave blank to default to 0x3600000000000000000000000000000000000000.
ARC_MAINNET_USDC=
# Canonical WETH on Arc mainnet, if one exists on day one (check docs.arc.io
# contract addresses and Uniswap's Arc deployment). Blank + ALLOW_MOCKS=true
# deploys a MockERC20 WETH — a demo, not a market.
ARC_MAINNET_WETH=
# Chainlink-compatible ETH/USD aggregator on Arc mainnet (check
# data.chain.link for an Arc network; Stork is the only oracle seen on
# testnet — needs an adapter). Blank + ALLOW_MOCKS=true deploys MockV3Aggregator.
ARC_MAINNET_ETH_USD_FEED=
# Official 1inch Aqua registry on Arc mainnet, if 1inch deploys there
# (https://github.com/1inch/aqua deployments). Blank = deploy our own copy, as on testnet.
ARC_MAINNET_AQUA=
# Explicit opt-in for mocks on a real-money chain. Never set this by habit.
ARC_MAINNET_ALLOW_MOCKS=false
# Optional: DAO fee recipient (defaults to the deployer).
FEE_RECIPIENT=

# ── Frontend (copy into frontend/.env.local) ────────────────────────────────
# Same chain id / RPC / explorer as above; the "Arc" network appears in the
# picker only when the first two are set.
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=
NEXT_PUBLIC_ARC_MAINNET_RPC=
NEXT_PUBLIC_ARC_MAINNET_EXPLORER=
# Until docs/arc-mainnet-deployment.md records the addresses in
# frontend/config/wagmi.ts DEPLOYED_ADDRESSES, the app reads them from here
# (the same fallback Anvil uses). Fill from the deploy output.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_WETH_ADDRESS=
NEXT_PUBLIC_AQUA=
NEXT_PUBLIC_SWAPVM_ROUTER=
NEXT_PUBLIC_SPOT_ORACLE=
NEXT_PUBLIC_PRICING_ENGINE=
NEXT_PUBLIC_PRICING_HOOK=
NEXT_PUBLIC_AQUA_VAULT=
NEXT_PUBLIC_SETTLEMENT=
NEXT_PUBLIC_SPREAD_VAULT=
NEXT_PUBLIC_MARGIN_VAULT=
NEXT_PUBLIC_MARGIN_BACKSTOP=
NEXT_PUBLIC_MARGIN_SETTLEMENT=
NEXT_PUBLIC_RFQ_VAULT=
NEXT_PUBLIC_COPILOT=1
